# Documentation template only. Do not copy real values into source control.
# Use the hosting secret store; this file is not loaded automatically.
NODE_ENV=production
PORT=3001
MONGO_URI=
JWT_SECRET=
# Optional full 40-character build SHA; Render may supply RENDER_GIT_COMMIT.
INOP_BUILD_SHA=
API_REQUEST_LOG_ENABLED=false

# S3-compatible protocol support is installed but DISABLED by default.
# Provider/vendor and credentials remain operator-selected, never auto-discovered.
AUDIT_EVIDENCE_STORAGE_ENABLED=false
AUDIT_EVIDENCE_STORAGE_PROVIDER=
AUDIT_EVIDENCE_STORAGE_PRIVATE_BUCKET_APPROVED=false
AUDIT_EVIDENCE_STORAGE_ENDPOINT=
AUDIT_EVIDENCE_STORAGE_BUCKET=
AUDIT_EVIDENCE_STORAGE_REGION=
AUDIT_EVIDENCE_STORAGE_ACCESS_KEY_ID=
AUDIT_EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
AUDIT_EVIDENCE_STORAGE_SESSION_TOKEN=

# Recruitment intake: separate from Audit storage. Documentation only; opt-in
# requires approved recovery/retention, private bucket and working ClamAV.
HR_CV_DURABLE_INTAKE_ENABLED=false
HR_CV_STORAGE_PROVIDER=disabled
HR_CV_STORAGE_ENDPOINT=
HR_CV_STORAGE_BUCKET=
HR_CV_STORAGE_REGION=
HR_CV_STORAGE_ACCESS_KEY_ID=
HR_CV_STORAGE_SECRET_ACCESS_KEY=
HR_CV_STORAGE_SESSION_TOKEN=
HR_CV_SCAN_ENABLED=false
# Absolute path to an operator-installed clamscan with fresh definitions.
HR_CV_SCAN_BINARY=
# Optional existing OCR adapter; runtime/models must be provisioned separately.
HR_CV_OCR_ENABLED=false
HR_CV_OCR_DATA_DIRECTORY=
# No durable intake scheduler is started by these settings. Its runOnce()
# scheduling needs separate review; HR_CV_PROCESSING_ENABLED is a different worker.
