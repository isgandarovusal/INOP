# Documentation template only. Do not copy real values into source control.
# Use the hosting secret store; this file is not loaded automatically.
NODE_ENV=production
PORT=3001
MONGO_URI=
JWT_SECRET=
# Optional full 40-character build SHA; Render may supply RENDER_GIT_COMMIT.
INOP_BUILD_SHA=
API_REQUEST_LOG_ENABLED=false

# S3-compatible protocol support is installed but DISABLED by default.
# Provider/vendor and credentials remain operator-selected, never auto-discovered.
AUDIT_EVIDENCE_STORAGE_ENABLED=false
AUDIT_EVIDENCE_STORAGE_PROVIDER=
AUDIT_EVIDENCE_STORAGE_PRIVATE_BUCKET_APPROVED=false
AUDIT_EVIDENCE_STORAGE_ENDPOINT=
AUDIT_EVIDENCE_STORAGE_BUCKET=
AUDIT_EVIDENCE_STORAGE_REGION=
AUDIT_EVIDENCE_STORAGE_ACCESS_KEY_ID=
AUDIT_EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
AUDIT_EVIDENCE_STORAGE_SESSION_TOKEN=
