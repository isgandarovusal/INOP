# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=15

# MongoDB
MONGO_URI=mongodb://localhost:27017/inop

# Authentication
# Use a long random value in real environments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Email (optional; candidate emails are logged as skipped if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Seed user passwords (required only when running npm run seed:users)
# Use at least 10 characters. Do not commit real passwords.
SEED_ADMIN_PASSWORD=
SEED_HR_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_MANAGER_PASSWORD=
