NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/inop

# Generate your own secret with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=inop
JWT_AUDIENCE=inop-users

# Comma-separated exact browser origins. Production must use the deployed origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 0 for direct local access; Compose sets 1 for its Nginx proxy.
TRUST_PROXY=0
ENABLE_API_DOCS=false

# Initial admin bootstrap only. Remove these after the account is created.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional SMTP settings; notifications require a configured mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
