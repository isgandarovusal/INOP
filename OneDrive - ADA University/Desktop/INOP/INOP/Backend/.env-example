MONGO_URI=mongodb://127.0.0.1:27017/inop?replicaSet=rs0
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=8h
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Comma-separated exact browser origins only if frontend is on another origin.
CORS_ORIGINS=
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct connections.
TRUST_PROXY=
ENABLE_SWAGGER=false
